# Required runtime configuration.
# Create NEW values for every independent installation. Never copy secrets from another deployment.
DATABASE_URL=
SESSION_SECRET=
PHONE_LOOKUP_PEPPER=
ROSTER_ENCRYPTION_KEY=

# Optional integrations: uncomment the complete group and provide real values.
# Leave unused variables unset; empty strings are not valid configuration.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Existing Web Push delivery is optional. New notice subscriptions are not required for in-app unread badges.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=

# Local-only first administrator bootstrap helpers.
# Do NOT add these four values to Vercel. Remove them from .env.local after bootstrap.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PHONE=
# BOOTSTRAP_SAM_NAME=
# BOOTSTRAP_SAM_LEADER=
